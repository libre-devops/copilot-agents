# Build output. rendered/ is committed on purpose: it is the drop-in delivery path for the
# default profile. Every other profile renders into build/ and is never committed.
dist/
build/

# Your own knowledge documents. knowledge/ itself is tracked, because the upstream standards are
# committed there, so anything internal goes in knowledge/local/ which is ignored wholesale. An
# internal document cannot then reach a public repository by being dropped in the wrong folder.
knowledge/local/

# Branding profiles are allowlisted, not denylisted. A profile you add is ignored unless it is
# named below, so an internal or customer profile cannot reach a public repository by accident.
profiles/*
!profiles/default.yaml
!profiles/example.yaml
!profiles/README.md

# Backups written by `just rebrand` before it rewrites anything.
.rebrand-backup/

# Python
__pycache__/
*.py[cod]
.venv/

# Editors and OS
.idea/
.vscode/
.DS_Store
*.swp
